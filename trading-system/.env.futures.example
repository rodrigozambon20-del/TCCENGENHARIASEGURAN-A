# Chaves da conta de FUTUROS testnet (SEPARADAS do spot).
# Copie para .env.futures e preencha.
#
# Como obter (testnet de futuros, dinheiro de mentira):
#   1) Acesse https://testnet.binancefuture.com
#   2) Entre e vá em "API Key" (no rodapé do painel)
#   3) Copie a API Key e a Secret Key para cá
#
# A conta de futuros testnet é SEPARADA da spot testnet — tem saldo próprio.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram/n8n são compartilhados com o spot (herdados do .env) se ficarem vazios.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
