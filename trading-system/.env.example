# Copie para .env e preencha. NUNCA commite o .env real.
# Crie a API key na Binance com:
#   [x] Enable Reading
#   [x] Enable Spot & Margin Trading
#   [ ] Enable Withdrawals   <- SEMPRE DESMARCADO
#   [x] Restrict access to trusted IPs only (IP do seu servidor)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Notificações no Telegram (RECOMENDADO — direto, sem n8n):
# 1) No Telegram, fale com @BotFather -> /newbot -> copie o token
# 2) Envie /start para o SEU bot recém-criado (obrigatório)
# 3) Fale com @userinfobot para descobrir seu ID numérico
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook do fluxo n8n (OPCIONAL, roteamento avançado p/ WhatsApp/Sheets)
N8N_WEBHOOK_URL=

# Opcional: CryptoPanic (agregador de notícias) — token GRATUITO em
# https://cryptopanic.com/developers/api/ . Sem token, o bot usa só as
# demais fontes gratuitas (RSS, Reddit, Fear & Greed), que já bastam.
CRYPTOPANIC_TOKEN=

# Opcional: LLM para a camada 2 do NLP de sentimento
ANTHROPIC_API_KEY=
